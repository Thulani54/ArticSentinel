{
  "name": "Luthando Flutter App",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "FLUTTER_VERSION": "3.27.1"
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PUB_CACHE": "/home/vscode/.pub-cache"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Luthando Flutter web",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "dart.lineLength": 80
      }
    }
  }
}
