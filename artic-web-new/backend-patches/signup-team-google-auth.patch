+def build_login_success_response(user):
+    """Token + full user/business payload, shared by password and Google login."""
+    email = user.email
+    try:
+        # Get or create authentication token
+        token, _ = Token.objects.get_or_create(user=user)
+
+        # Get user profile with related business and secondary businesses
+        profile = UserProfile.objects.select_related('business').prefetch_related(
+            'secondary_businesses'
+        ).get(user=user)
+
+        # Comprehensive user data
