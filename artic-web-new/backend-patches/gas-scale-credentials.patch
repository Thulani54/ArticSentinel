# ---- host: /usr/local/sbin/exvr-mqtt-credsync
#!/usr/bin/env python3
"""Apply scale-login requests from the ArticSentinel backend to Mosquitto.

Django (which cannot write the broker's files) drops JSON requests in
PENDING: {"username": "<device id>", "hash": "$7$101$..."} — a PBKDF2 hash,
never a plaintext password — or {"username": ..., "delete": true} to revoke. This merges each into the password file, keeps
the file broker-owned and private, then reloads the broker (SIGHUP keeps
connected devices online). Run by exvr-mqtt-credsync.path.
"""
import fcntl, json, os, re, subprocess, sys, tempfile

PENDING = "/home/vmrvsnyo/exvr/mosquitto/pending"
PASSWD = "/home/vmrvsnyo/exvr/mosquitto/config/passwd"
BROKER = "exvr_mqtt"
RESERVED = {"gas-bridge"}
USER_RE = re.compile(r"^[A-Za-z0-9._-]{1,50}$")
HASH_RE = re.compile(r"^\$7\$\d+\$[A-Za-z0-9+/=]+\$[A-Za-z0-9+/=]+$")

def main():
    requests = sorted(f for f in os.listdir(PENDING) if f.endswith(".json"))
    if not requests:
        return 0
    with open(PASSWD + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(PASSWD) as fh:
            lines = [l.rstrip("\n") for l in fh if l.strip()]
        entries = {l.split(":", 1)[0]: l for l in lines}
        applied = 0
        for name in requests:
            path = os.path.join(PENDING, name)
            try:
                req = json.load(open(path))
                user = str(req["username"])
                if user in RESERVED or not USER_RE.match(user):
                    raise ValueError(f"rejected request for {user!r}")
                if req.get("delete"):
                    # {"username": ..., "delete": true} revokes the login
                    if entries.pop(user, None) is not None:
                        applied += 1
                        print(f"credsync: revoked login for {user}")
                else:
                    pwhash = str(req["hash"])
                    if not HASH_RE.match(pwhash):
                        raise ValueError(f"rejected hash for {user!r}")
                    entries[user] = f"{user}:{pwhash}"
                    applied += 1
                    print(f"credsync: set login for {user}")
            except Exception as exc:  # bad request: drop it, keep going
                print(f"credsync: {name}: {exc}", file=sys.stderr)
            finally:
                os.unlink(path)
        if applied:
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(PASSWD))
            with os.fdopen(fd, "w") as out:
                out.write("\n".join(entries.values()) + "\n")
            os.chown(tmp, 1883, 1883)
            os.chmod(tmp, 0o700)
            os.replace(tmp, PASSWD)
            subprocess.run(["docker", "kill", "-s", "HUP", BROKER], check=True, capture_output=True)
            print("credsync: broker reloaded")
    return 0

if __name__ == "__main__":
    sys.exit(main())
